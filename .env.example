APP_NAME="Daleel CRM API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Cairo

LOG_CHANNEL=stack
LOG_STACK=stderr,structured
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL is the intended application database. Values below are local placeholders only.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=daleel_crm_api
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# CORE-01 isolated authority bindings: deployment-only 32-byte hex secret.
CORE01_SESSION_BINDING_KEY=change_me_64_hex_chars

# Separate provider control-plane credential for the same reviewed PostgreSQL target.
# Supply these through the local process/secret manager; never use the migration owner.
PROVIDER_DB_HOST=127.0.0.1
PROVIDER_DB_PORT=5432
PROVIDER_DB_DATABASE=daleel_crm_api
PROVIDER_DB_USERNAME=change_me_provider
PROVIDER_DB_PASSWORD=change_me_provider
PROVIDER_DB_SSLMODE=prefer
PROVIDER_ALLOWED_ORIGINS=http://localhost:3002
# Exact direct Host authorities allowed to reach the Provider API; empty means deny all.
PROVIDER_API_HOSTS=

# Provider control-plane executor; legacy onboarding connection is retained for compatibility.
PROVIDER_CONTROL_DB_HOST=127.0.0.1
PROVIDER_CONTROL_DB_PORT=5432
PROVIDER_CONTROL_DB_DATABASE=daleel_crm_api
PROVIDER_CONTROL_DB_USERNAME=change_me_provider_control
PROVIDER_CONTROL_DB_PASSWORD=change_me_provider_control
PROVIDER_CONTROL_DB_SSLMODE=prefer
ONBOARDING_DB_HOST=127.0.0.1
ONBOARDING_DB_PORT=5432
ONBOARDING_DB_DATABASE=daleel_crm_api
ONBOARDING_DB_USERNAME=change_me_onboarding
ONBOARDING_DB_PASSWORD=change_me_onboarding
ONBOARDING_DB_SSLMODE=prefer

# Tenant staff authentication uses three distinct PostgreSQL principals.
# These NOLOGIN-group-backed credentials are supplied only by a secret manager.
TENANT_HOST_DB_HOST=127.0.0.1
TENANT_HOST_DB_PORT=5432
TENANT_HOST_DB_DATABASE=daleel_crm_api
TENANT_HOST_DB_USERNAME=change_me_hostname_resolver
TENANT_HOST_DB_PASSWORD=change_me_hostname_resolver
TENANT_HOST_DB_SSLMODE=prefer
TENANT_AUTH_DB_HOST=127.0.0.1
TENANT_AUTH_DB_PORT=5432
TENANT_AUTH_DB_DATABASE=daleel_crm_api
TENANT_AUTH_DB_USERNAME=change_me_tenant_auth
TENANT_AUTH_DB_PASSWORD=change_me_tenant_auth
TENANT_AUTH_DB_SSLMODE=prefer
TENANT_RUNTIME_DB_HOST=127.0.0.1
TENANT_RUNTIME_DB_PORT=5432
TENANT_RUNTIME_DB_DATABASE=daleel_crm_api
TENANT_RUNTIME_DB_USERNAME=change_me_tenant_runtime
TENANT_RUNTIME_DB_PASSWORD=change_me_tenant_runtime
TENANT_RUNTIME_DB_SSLMODE=prefer

# Redis is the intended cache, lock, rate-limit, queue, and future session backend.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=daleel-crm-api-
CACHE_STORE=redis
RATE_LIMIT_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
# Local first-party proof uses persistent file sessions; staging/production use Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=120
AUTH_ABSOLUTE_SESSION_LIFETIME=28800
SESSION_ENCRYPT=true
# Local HTTP only. Non-local environments force Secure cookies in config/session.php.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:3002,localhost:8000

# Identity defaults; no public registration or bearer-token flow is enabled.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_VERIFICATION_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
FOUNDATION_REDIS_CONFIGURED=false

# Health checks are opt-in and perform read-only dependency checks when enabled.
FOUNDATION_DEPENDENCY_CHECKS=false
TENANCY_DISPOSABLE_BOOTSTRAP=false
BASE_DOMAIN=
TENANCY_ALLOW_LOCALHOST_BASE_DOMAIN=false
TENANCY_LOCAL_TEST_BASE_DOMAIN=
TENANT_STAFF_AUTH_ENABLED=false

# Exact local origins only; replace with approved exact origins per environment.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

FILESYSTEM_DISK=local
# S3-compatible production settings are supplied through the environment/secret manager.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="api@example.test"
MAIL_FROM_NAME="${APP_NAME}"
